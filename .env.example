# =============================================================================
# HowzYourDay — environment (set these locally and in the Cartesia dashboard)
# =============================================================================

# --- LLM via OpenRouter ------------------------------------------------------
# MODEL is auto-resolved from OpenRouter's catalog (prefers gemini-2.5-flash);
# override here to pin a specific one. Always the LiteLLM "openrouter/<slug>" form.
MODEL=openrouter/google/gemini-2.5-flash
OPENROUTER_API_KEY=sk-or-...

# --- Upstash Redis (REST) — fast per-caller profile card ---------------------
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_rest_token
# REDIS_TTL_SECONDS=7776000   # 90d; hot card is fast, not forgetful

# --- Mem0 Platform (hosted) — semantic long-term memory ----------------------
MEM0_API_KEY=m0-...
