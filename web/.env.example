# HowzYourDay - web companion backend env

# --- Cartesia (same account as the agent) ---
CARTESIA_API_KEY=sk_car_...
AGENT_ID=agent_...               # the deployed HowzYourDay agent
FROM_NUMBER_ID=ap_...            # a Cartesia phone number, for outbound "call me"
CARTESIA_API_VERSION=2026-03-01
CARTESIA_WS_VERSION=2025-04-16

# --- Magic-link email (Fastmail SMTP) ---
SMTP_HOST=smtp.fastmail.com
SMTP_PORT=465
SMTP_USER=you@yourdomain.com            # Fastmail address (SMTP login + sender)
SMTP_PASS=your_fastmail_app_password    # app-specific password, NOT your login password
# MAGIC_FROM=you@yourdomain.com         # optional; defaults to SMTP_USER
# MAGIC_MAX_AGE=1800                    # magic-link validity in seconds (30 min)

# --- Session ---
SESSION_SECRET=generate-a-long-random-string
SESSION_DAYS=15
BASE_URL=http://localhost:8787
PORT=8787
